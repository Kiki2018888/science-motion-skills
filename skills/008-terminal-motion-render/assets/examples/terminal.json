      "id": "source",
      "kind": "code",
      "label": "代码展开",
      "duration": 4,
      "lines": [
        "import { Agent, trace } from \"./runtime\";",
        "",
        "const worker = new Agent({",
        "  model: \"demo-primary\",",
        "  tools: [search, readFile, writeFile],",
        "  concurrency: 8,",
        "});",
        "",
        "export async function run(task: Task) {",
        "  const plan = await worker.plan(task);",
        "  for (const step of plan.steps) {",
        "    const result = await worker.execute(step);",
        "    trace.write({ step, result, status: \"ok\" });",
        "    await checkpoint.save(result);",
        "  }",
        "  return { completed: true, traceId: task.id };",
        "}",
        "",
        "// inspect the route before returning a result",
        "const route = await router.resolve(request);",
        "logger.info(\"route selected\", route.model);",
        "await queue.flush();"
      ],
