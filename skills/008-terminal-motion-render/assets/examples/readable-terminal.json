        "import { createSession } from \"./runtime\";",
        "const tools = [\"search\", \"read\", \"summarize\"];",
        "const input = await loadEventQueue();",
        "const session = createSession({ mode: \"monitor\", trace: true });",
        "const result = await session.run({ input, tools, output: \"structured-record\", preserveSources: true, includeTiming: true });",
        "await saveRecords(result.records);",
        {
          "text": "return result.status === \"complete\" ? result.records : retryWithContext(result);",
          "emphasis": [
            {
              "text": "result.records"
            }
          ]
        }
